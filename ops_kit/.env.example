# Local .env template for the new bot. Copy to `.env` (gitignored) and fill in.
# On Render these same keys go in the dashboard as env vars (secrets = sync:false).
# The loader must do env.setdefault (real env WINS over .env), like EMS's run.py.

# --- run mode ---
BOT_TESTNET=true
BOT_DRY_RUN=true
BOT_RISK=3
BOT_MAX_DAILY_LOSSES=10
BOT_MAX_DAILY_LOSS_R=0
BOT_STATUS_MODE=steps
BOT_STATE_PATH=bot_state.json

# --- cTrader Open API (from connect.spotware.com app + OAuth flow) ---
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=

# --- monitoring (optional; blank = feature off) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEALTHCHECK_URL=
